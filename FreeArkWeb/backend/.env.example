# =============================================================================
# FreeArkWeb 后端环境变量模板（.env.example）
# -----------------------------------------------------------------------------
# 用法：复制为 .env 并按环境填写。cp .env.example .env
# 加载方式：freearkweb/settings.py 顶部 `from dotenv import load_dotenv; load_dotenv()`
#
# ⚠ 本文件只列出「真正被 settings.py 读取」的变量。旧开发 .env 里出现的
#   DB_ENGINE / DB_NAME / DB_HOST / DB_USER / DB_PASSWORD / DB_PORT /
#   CORS_ALLOWED_ORIGINS / WORKERS 均【不生效】（见文末「死变量说明」），勿照抄。
# =============================================================================

# ── Django 基础 ──────────────────────────────────────────────────────────────
# 安全密钥：生产必须用强随机串。生成方法见 backend/DEPLOYMENT_GUIDE.md，
# 或：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 注意：不要加引号（含特殊字符如 ) 时 bash source 会解析中断）。
SECRET_KEY=please-generate-a-strong-random-secret-key

# 调试模式：生产必须 False
DEBUG=False

# 允许的主机（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.31.51

# HTTPS 强制跳转（生产经 nginx/frp 时按需 True）
SECURE_SSL_REDIRECT=False

# ── 日志 ─────────────────────────────────────────────────────────────────────
# 生产全局默认 ERROR；排障时临时拉高到 INFO（见 memory: freeark-prod-log-levels）
APP_LOG_LEVEL=ERROR
DJANGO_LOG_LEVEL=WARNING
# 日志目录（生产建议绝对路径，如 /home/yangyang/freeark-prod/logs/）
LOG_DIR=

# ── 会话 / 服务账号 ──────────────────────────────────────────────────────────
SESSION_INACTIVITY_TIMEOUT=1800
SESSION_EXTENDED_TIMEOUT=604800
ACTIVITY_THROTTLE_SECONDS=300
# 服务账号用户名（逗号分隔），豁免滑动窗口不活跃超时，供 energy-agent 等写设备
SERVICE_ACCOUNT_USERNAMES=energy-agent

# ── 微信小程序 ───────────────────────────────────────────────────────────────
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# ── 媒体 ─────────────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media

# ── 大屏 MQTT（SCREEN_MQTT_*，仅供屏幕/大屏推送使用）─────────────────────────
SCREEN_MQTT_PROTOCOL=wxs
SCREEN_MQTT_HOST=www.ttqingjiao.site
SCREEN_MQTT_PORT=8084
SCREEN_MQTT_PATH=/mqtt
SCREEN_MQTT_USERNAME=admin
SCREEN_MQTT_PASSWORD=public

# ── AI 聊天主链路（LangGraph + DeepSeek）─────────────────────────────────────
# 聊天后端：openclaw | langgraph（2026-06 起生产切 langgraph）
CHAT_BACKEND=langgraph
# 主模型 / 路由模型
LANGGRAPH_MODEL=deepseek-v4-flash
LANGGRAPH_ROUTER_MODEL=
# DeepSeek OpenAI 兼容端点（进程内直连，非 OpenAI）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# LLM 超时（秒）
LANGGRAPH_LLM_TIMEOUT=60
# 调试开关：True 走假 LLM（本地测试，不发外部请求）
LANGGRAPH_USE_FAKE_LLM=False
# 路由语义/守卫等（多数有默认值，一般无需设置）
LANGGRAPH_ROUTER_GUARD=True
LANGGRAPH_ROUTER_SEM_TAU=0.65
LANGGRAPH_ROUTER_SEM_MARGIN=0.05
# Skill / Agent 目录（相对路径留空用默认）
LANGGRAPH_SKILL_DIR=
LANGGRAPH_AGENTS_DIR=
# 工具调用模式：http（默认）
FA_TOOLS_MODE=http
# 注入历史轮数
CHAT_HISTORY_INJECT_TURNS=20

# ── RAG 向量检索（embedding 走火山方舟 Ark）──────────────────────────────────
# 嵌入模型端点。生产当前用 Ark 预置推理接入点（doubao_multimodal）：
RAG_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
RAG_EMBEDDING_MODEL=ep-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_API_STYLE=openai
# 检索参数
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── 豆包多模态（图片提问 VLM，火山方舟 Ark）──────────────────────────────────
# 基础端点（与 RAG 共用 Ark，key 复用 DOUBAO_API_KEY）
DOUBAO_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
# 视觉模型。⚠ 2026-09 实测：旧 doubao-1.5-vision-pro-32k-250115 已 ClosedEndpoint。
# 可用（同一 key 实测真看图）：doubao-seed-2-0-pro-260215（pro，生产在用）
#   doubao-seed-2-0-lite-260428 / doubao-seed-2-0-mini-260428
DOUBAO_VISION_MODEL=doubao-seed-2-0-pro-260215
# 调用超时 / 最大重试
DOUBAO_VISION_TIMEOUT=60
DOUBAO_VISION_MAX_RETRIES=1
# 进程内临时图片存储
VISION_UPLOAD_TTL=600
VISION_UPLOAD_MAX_TOTAL_MB=50

# =============================================================================
# 死变量说明（旧 .env 里有，但 settings.py 不读取，设了也不生效）
# -----------------------------------------------------------------------------
# 数据库：settings.py 中 USE_SQLITE / MYSQL_DATABASE / SQLITE_DATABASE 均为硬编码，
#   未从 env 读取。生产 MySQL 凭据写在 settings.py 的 MYSQL_DATABASE 里
#   （NAME=freeark, USER=root, HOST=192.168.31.98）。DB_ENGINE/DB_NAME/DB_HOST/
#   DB_USER/DB_PASSWORD/DB_PORT 全是历史遗留，不生效。
# CORS：CORS_ALLOWED_ORIGINS 在 settings.py 是硬编码列表，不从 env 读。
# WORKERS：无代码读取（由 gunicorn_config.py 控制进程数）。
# =============================================================================
