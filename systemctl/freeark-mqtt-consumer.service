[Unit]
Description=FreeArk mqtt-consumer Service
After=network.target
# 关闭启动频率限制：mqtt-consumer 依赖"自杀→重启"自愈，绝不允许因限流而永久停在 failed
StartLimitIntervalSec=0

[Service]
Type=simple
User=yangyang
WorkingDirectory=/home/yangyang/Freeark/FreeArk/
ExecStart=/home/yangyang/Freeark/FreeArk/venv/bin/python /home/yangyang/Freeark/FreeArk/FreeArkWeb/backend/freearkweb/manage.py mqtt_consumer_service --auto-restart --monitor-interval 60
Restart=always
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=freeark-mqtt-consumer

[Install]
WantedBy=multi-user.target